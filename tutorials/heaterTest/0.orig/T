    floor
    	{
        type externalWallHeatFluxTemperature;
        mode power;
        kappaMethod fluidThermo;
        value uniform 300;
        Q 100;
        }

    ceiling
    	{
        type zeroGradient;
        }

    fixedWalls
    	{
            type zeroGradient;
        }
}


